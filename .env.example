LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-gateway.example/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model
LLM_ENABLE_THINKING=false
AMAP_MCP_URL=https://mcp.amap.com/mcp?key=replace-with-your-amap-key
DASHSCOPE_API_KEY=
TOOL_TIMEOUT=20
TOOL_RETRIES=1
MAX_TOOL_CALLS=24
RUN_TIMEOUT=180
RECURSION_LIMIT=40
MAX_MODEL_CALLS=20
PLAN_REPAIRS=1
# 留空使用项目.data目录的SQLite；PostgreSQL需另装psycopg驱动并配置DSN
DATABASE_URL=
# 0为默认认证页面；1仅供可信本机访问旧local记录，禁止对公网开启
TRAVEL_LOCAL_MODE=0
