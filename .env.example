# 复制为 .env 并填入模型配置；.env 不会进入版本库。
# 配置项统一由 python-impl/config.py 解析，全部可选（除模型名与密钥外都有默认值）。

# ── 模型（必需）──
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=45

# ── 会话与记忆（可选）──
# Redis 为可选的会话缓存；未配置或未安装 redis 包时退化为进程内存存储。
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MAX_TURNS=20
SHORT_TERM_TTL_SECONDS=1800
# 知识库索引路径；注意当前词法检索只存在进程内存中，尚未落盘。
KNOWLEDGE_INDEX_PATH=.data/knowledge/index

# ── 服务（可选）──
HOST=127.0.0.1
PORT=8001
REQUEST_TIMEOUT_SECONDS=180
# 全局并发上限，用于避免打爆上游模型网关；调大前请确认上游配额。
MAX_CONCURRENT_REQUESTS=1

# ── 可观测（可选）──
OTEL_SERVICE_NAME=smart-cs-multi-agent
# 配置后 span 走 OTLP 上报；不配置则打印到标准输出。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
