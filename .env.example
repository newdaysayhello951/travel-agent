# 复制为 .env 并填入模型配置；.env 不会进入版本库。
# 配置项统一由 python-impl/config.py 解析，除模型名与密钥外都有默认值。

# ── 模型（必需）──
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=45
# 结构化输出方式：function_calling / json_schema / json_mode
# 实测部分网关只支持 function_calling。
LLM_STRUCTURED_METHOD=function_calling

# ── 安全（重要）──
# 逗号分隔的 API Key 列表；配置后所有业务接口都要求
#   Authorization: Bearer <key>   或   X-API-Key: <key>
# 留空且只监听 127.0.0.1 时，本机演示可直接访问（启动会打印警告）；
# 若 HOST 不是本机地址却没有配置 API_KEYS，服务会拒绝启动。
API_KEYS=
AUTH_ENABLED=true
# 按调用方分桶的限流与并发上限
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
MAX_CONCURRENT_PER_KEY=2
# 输入侧检查的字符上限（Pydantic 的硬上限是 4000）
INPUT_MAX_CHARS=2000

# ── 持久化（可选）──
# 业务数据（工单）与图检查点分开存放
DATABASE_PATH=.data/app.db
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite
# 知识库源文件目录与分块索引缓存位置
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_INDEX_PATH=.data/knowledge/index

# ── 会话与记忆（可选）──
# Redis 为可选的会话缓存；未配置或未安装 redis 包时退化为进程内存存储。
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MAX_TURNS=20
SHORT_TERM_TTL_SECONDS=1800
SHORT_TERM_MAX_SESSIONS=1000
# 送进模型的历史消息条数上限，超出部分会从检查点移除
MAX_CONTEXT_MESSAGES=20

# ── 服务（可选）──
HOST=127.0.0.1
PORT=8001
REQUEST_TIMEOUT_SECONDS=180

# ── 工具与可观测（可选）──
MCP_CALL_LOG_MAX=200
OTEL_SERVICE_NAME=smart-cs-multi-agent
# 配置后 span 走 OTLP 上报；不配置则打印到标准输出。
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
