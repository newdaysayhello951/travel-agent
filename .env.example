# 复制为 .env 并填入模型配置；.env 不会进入版本库。
# 配置项统一由 python-impl/config.py 解析，除模型名与密钥外都有默认值。

# ── 模型（必需）──
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=your-model
LLM_ENABLE_THINKING=false
LLM_TIMEOUT_SECONDS=45
LLM_STRUCTURED_METHOD=function_calling

# ── 安全（重要）──
API_KEYS=
AUTH_ENABLED=true
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
MAX_CONCURRENT_PER_KEY=2
INPUT_MAX_CHARS=2000

# ── 持久化（可选）──
DATABASE_PATH=.data/app.db
CHECKPOINT_DB_PATH=.data/checkpoints.sqlite
KNOWLEDGE_DIR=knowledge
KNOWLEDGE_INDEX_PATH=.data/knowledge/index

# ── 会话与记忆（可选）──
REDIS_URL=redis://localhost:6379/0
SHORT_TERM_MAX_TURNS=20
SHORT_TERM_TTL_SECONDS=1800
SHORT_TERM_MAX_SESSIONS=1000
MAX_CONTEXT_MESSAGES=20

# ── 服务（可选）──
HOST=127.0.0.1
PORT=8001
REQUEST_TIMEOUT_SECONDS=180

# ── 工具与可观测（可选）──
MCP_CALL_LOG_MAX=200
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=smart-cs-multi-agent
# 追踪采样比例（0~1）；全量上报在高流量下会淹没后端
OTEL_SAMPLE_RATIO=1.0
# 配置后 span 走 OTLP 上报；不配置则打印到标准输出
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317